<?xml version="1.0" encoding="UTF-8"?>
<rdf:RDF
  xmlns:rdf="http://www.w3.org/1999/02/22-rdf-syntax-ns#"
  xmlns:rdfs="http://www.w3.org/2000/01/rdf-schema#"
  xmlns:owl="http://www.w3.org/2002/07/owl#"
  xmlns:xsd="http://www.w3.org/2001/XMLSchema#"
  xmlns:dc="http://purl.org/dc/elements/1.1/"
  xmlns:cn="http://www.semanticweb.org/ontologies/2024/cartoonnetwork#">

  <!-- Ontoloji Meta Verisi -->
  <owl:Ontology rdf:about="http://www.semanticweb.org/ontologies/2024/cartoonnetwork">
    <dc:title>Cartoon Network Ontolojisi - RDF Sürümü</dc:title>
    <dc:description>Cartoon Network çizgi filmlerini, karakterlerini ve ilişkilerini tanımlayan RDF/XML belgesi.</dc:description>
    <owl:versionInfo>1.0.0</owl:versionInfo>
  </owl:Ontology>

  <!-- ===================== SINIF TANIMLAMALARI ===================== -->

  <rdfs:Class rdf:about="cn:ÇizgiFilm">
    <rdfs:label xml:lang="tr">Çizgi Film</rdfs:label>
    <rdfs:label xml:lang="en">Cartoon</rdfs:label>
    <rdfs:comment xml:lang="tr">Cartoon Network yayın kuruluşunda gösterilen animasyon yapımı.</rdfs:comment>
  </rdfs:Class>

  <rdfs:Class rdf:about="cn:AksiyonÇizgiFilmi">
    <rdfs:subClassOf rdf:resource="cn:ÇizgiFilm"/>
    <rdfs:label xml:lang="tr">Aksiyon Çizgi Filmi</rdfs:label>
  </rdfs:Class>

  <rdfs:Class rdf:about="cn:KomediÇizgiFilmi">
    <rdfs:subClassOf rdf:resource="cn:ÇizgiFilm"/>
    <rdfs:label xml:lang="tr">Komedi Çizgi Filmi</rdfs:label>
  </rdfs:Class>

  <rdfs:Class rdf:about="cn:BilimKurguÇizgiFilmi">
    <rdfs:subClassOf rdf:resource="cn:ÇizgiFilm"/>
    <rdfs:label xml:lang="tr">Bilim Kurgu Çizgi Filmi</rdfs:label>
  </rdfs:Class>

  <rdfs:Class rdf:about="cn:FanteziÇizgiFilmi">
    <rdfs:subClassOf rdf:resource="cn:ÇizgiFilm"/>
    <rdfs:label xml:lang="tr">Fantezi Çizgi Filmi</rdfs:label>
  </rdfs:Class>

  <rdfs:Class rdf:about="cn:Karakter">
    <rdfs:label xml:lang="tr">Karakter</rdfs:label>
    <rdfs:label xml:lang="en">Character</rdfs:label>
  </rdfs:Class>

  <rdfs:Class rdf:about="cn:Kahraman">
    <rdfs:subClassOf rdf:resource="cn:Karakter"/>
    <rdfs:label xml:lang="tr">Kahraman</rdfs:label>
    <rdfs:label xml:lang="en">Hero</rdfs:label>
  </rdfs:Class>

  <rdfs:Class rdf:about="cn:KötüAdam">
    <rdfs:subClassOf rdf:resource="cn:Karakter"/>
    <rdfs:label xml:lang="tr">Kötü Adam</rdfs:label>
    <rdfs:label xml:lang="en">Villain</rdfs:label>
  </rdfs:Class>

  <rdfs:Class rdf:about="cn:YanKarakter">
    <rdfs:subClassOf rdf:resource="cn:Karakter"/>
    <rdfs:label xml:lang="tr">Yan Karakter</rdfs:label>
    <rdfs:label xml:lang="en">Supporting Character</rdfs:label>
  </rdfs:Class>

  <rdfs:Class rdf:about="cn:YapımcıŞirket">
    <rdfs:label xml:lang="tr">Yapımcı Şirket</rdfs:label>
    <rdfs:label xml:lang="en">Production Company</rdfs:label>
  </rdfs:Class>

  <rdfs:Class rdf:about="cn:Yaratıcı">
    <rdfs:label xml:lang="tr">Yaratıcı</rdfs:label>
    <rdfs:label xml:lang="en">Creator</rdfs:label>
  </rdfs:Class>

  <!-- ===================== ÖZELLİK TANIMLAMALARI ===================== -->

  <rdf:Property rdf:about="cn:karakteriVar">
    <rdfs:domain rdf:resource="cn:ÇizgiFilm"/>
    <rdfs:range rdf:resource="cn:Karakter"/>
    <rdfs:label xml:lang="tr">karakteri var</rdfs:label>
  </rdf:Property>

  <rdf:Property rdf:about="cn:tarafındanYaratıldı">
    <rdfs:domain rdf:resource="cn:ÇizgiFilm"/>
    <rdfs:range rdf:resource="cn:Yaratıcı"/>
    <rdfs:label xml:lang="tr">tarafından yaratıldı</rdfs:label>
  </rdf:Property>

  <rdf:Property rdf:about="cn:tarafındanYapıldı">
    <rdfs:domain rdf:resource="cn:ÇizgiFilm"/>
    <rdfs:range rdf:resource="cn:YapımcıŞirket"/>
    <rdfs:label xml:lang="tr">tarafından yapıldı</rdfs:label>
  </rdf:Property>

  <rdf:Property rdf:about="cn:arkadaşı">
    <rdfs:domain rdf:resource="cn:Karakter"/>
    <rdfs:range rdf:resource="cn:Karakter"/>
    <rdfs:label xml:lang="tr">arkadaşı</rdfs:label>
  </rdf:Property>

  <rdf:Property rdf:about="cn:düşmanı">
    <rdfs:domain rdf:resource="cn:Karakter"/>
    <rdfs:range rdf:resource="cn:Karakter"/>
    <rdfs:label xml:lang="tr">düşmanı</rdfs:label>
  </rdf:Property>

  <rdf:Property rdf:about="cn:yayınYılı">
    <rdfs:domain rdf:resource="cn:ÇizgiFilm"/>
    <rdfs:range rdf:resource="xsd:integer"/>
    <rdfs:label xml:lang="tr">yayın yılı</rdfs:label>
  </rdf:Property>

  <rdf:Property rdf:about="cn:sezonSayısı">
    <rdfs:domain rdf:resource="cn:ÇizgiFilm"/>
    <rdfs:range rdf:resource="xsd:integer"/>
    <rdfs:label xml:lang="tr">sezon sayısı</rdfs:label>
  </rdf:Property>

  <!-- ===================== BİREYLER ===================== -->

  <!-- Cartoon Network Studios -->
  <cn:YapımcıŞirket rdf:about="cn:CartoonNetworkStudios">
    <rdfs:label>Cartoon Network Studios</rdfs:label>
    <cn:ülke>ABD</cn:ülke>
  </cn:YapımcıŞirket>

  <!-- Adventure Time -->
  <cn:FanteziÇizgiFilmi rdf:about="cn:AdventureTime">
    <rdfs:label xml:lang="en">Adventure Time</rdfs:label>
    <rdfs:label xml:lang="tr">Macera Zamanı</rdfs:label>
    <cn:yayınYılı rdf:datatype="xsd:integer">2010</cn:yayınYılı>
    <cn:sezonSayısı rdf:datatype="xsd:integer">10</cn:sezonSayısı>
    <cn:tarafındanYapıldı rdf:resource="cn:CartoonNetworkStudios"/>
    <cn:karakteriVar rdf:resource="cn:Finn"/>
    <cn:karakteriVar rdf:resource="cn:Jake"/>
    <cn:karakteriVar rdf:resource="cn:IceKing"/>
  </cn:FanteziÇizgiFilmi>

  <!-- Steven Universe -->
  <cn:AksiyonÇizgiFilmi rdf:about="cn:StevenUniverse">
    <rdfs:label xml:lang="en">Steven Universe</rdfs:label>
    <rdfs:label xml:lang="tr">Steven Evren</rdfs:label>
    <cn:yayınYılı rdf:datatype="xsd:integer">2013</cn:yayınYılı>
    <cn:sezonSayısı rdf:datatype="xsd:integer">5</cn:sezonSayısı>
    <cn:tarafındanYapıldı rdf:resource="cn:CartoonNetworkStudios"/>
    <cn:karakteriVar rdf:resource="cn:Steven"/>
    <cn:karakteriVar rdf:resource="cn:Garnet"/>
  </cn:AksiyonÇizgiFilmi>

  <!-- Samurai Jack -->
  <cn:AksiyonÇizgiFilmi rdf:about="cn:SamuraiJack">
    <rdfs:label xml:lang="en">Samurai Jack</rdfs:label>
    <rdfs:label xml:lang="tr">Samuray Jack</rdfs:label>
    <cn:yayınYılı rdf:datatype="xsd:integer">2001</cn:yayınYılı>
    <cn:sezonSayısı rdf:datatype="xsd:integer">5</cn:sezonSayısı>
    <cn:tarafındanYapıldı rdf:resource="cn:CartoonNetworkStudios"/>
    <cn:karakteriVar rdf:resource="cn:Jack"/>
    <cn:karakteriVar rdf:resource="cn:Aku"/>
  </cn:AksiyonÇizgiFilmi>

  <!-- The Powerpuff Girls -->
  <cn:AksiyonÇizgiFilmi rdf:about="cn:ThePowerpuffGirls">
    <rdfs:label xml:lang="en">The Powerpuff Girls</rdfs:label>
    <rdfs:label xml:lang="tr">Güçlü Kızlar</rdfs:label>
    <cn:yayınYılı rdf:datatype="xsd:integer">1998</cn:yayınYılı>
    <cn:sezonSayısı rdf:datatype="xsd:integer">6</cn:sezonSayısı>
    <cn:tarafındanYapıldı rdf:resource="cn:CartoonNetworkStudios"/>
    <cn:karakteriVar rdf:resource="cn:Blossom"/>
    <cn:karakteriVar rdf:resource="cn:Bubbles"/>
    <cn:karakteriVar rdf:resource="cn:Buttercup"/>
    <cn:karakteriVar rdf:resource="cn:MojoJojo"/>
  </cn:AksiyonÇizgiFilmi>

  <!-- Dexter's Laboratory -->
  <cn:KomediÇizgiFilmi rdf:about="cn:DextersLaboratory">
    <rdfs:label xml:lang="en">Dexter's Laboratory</rdfs:label>
    <rdfs:label xml:lang="tr">Dexter'ın Laboratuvarı</rdfs:label>
    <cn:yayınYılı rdf:datatype="xsd:integer">1996</cn:yayınYılı>
    <cn:sezonSayısı rdf:datatype="xsd:integer">4</cn:sezonSayısı>
    <cn:tarafındanYapıldı rdf:resource="cn:CartoonNetworkStudios"/>
    <cn:karakteriVar rdf:resource="cn:Dexter"/>
    <cn:karakteriVar rdf:resource="cn:Dee_Dee"/>
  </cn:KomediÇizgiFilmi>

  <!-- Ben 10 -->
  <cn:BilimKurguÇizgiFilmi rdf:about="cn:Ben10">
    <rdfs:label xml:lang="en">Ben 10</rdfs:label>
    <cn:yayınYılı rdf:datatype="xsd:integer">2005</cn:yayınYılı>
    <cn:sezonSayısı rdf:datatype="xsd:integer">4</cn:sezonSayısı>
    <cn:tarafındanYapıldı rdf:resource="cn:CartoonNetworkStudios"/>
    <cn:karakteriVar rdf:resource="cn:BenTennyson"/>
  </cn:BilimKurguÇizgiFilmi>

  <!-- Regular Show -->
  <cn:KomediÇizgiFilmi rdf:about="cn:RegularShow">
    <rdfs:label xml:lang="en">Regular Show</rdfs:label>
    <rdfs:label xml:lang="tr">Sıradan Gösteri</rdfs:label>
    <cn:yayınYılı rdf:datatype="xsd:integer">2010</cn:yayınYılı>
    <cn:sezonSayısı rdf:datatype="xsd:integer">8</cn:sezonSayısı>
    <cn:tarafındanYapıldı rdf:resource="cn:CartoonNetworkStudios"/>
    <cn:karakteriVar rdf:resource="cn:Mordecai"/>
    <cn:karakteriVar rdf:resource="cn:Rigby"/>
  </cn:KomediÇizgiFilmi>

  <!-- KARAKTERLER -->

  <cn:Kahraman rdf:about="cn:Finn">
    <rdfs:label>Finn the Human</rdfs:label>
    <cn:arkadaşı rdf:resource="cn:Jake"/>
    <cn:düşmanı rdf:resource="cn:IceKing"/>
  </cn:Kahraman>

  <cn:Kahraman rdf:about="cn:Jake">
    <rdfs:label>Jake the Dog</rdfs:label>
    <cn:arkadaşı rdf:resource="cn:Finn"/>
  </cn:Kahraman>

  <cn:KötüAdam rdf:about="cn:IceKing">
    <rdfs:label>Ice King</rdfs:label>
    <cn:düşmanı rdf:resource="cn:Finn"/>
  </cn:KötüAdam>

  <cn:Kahraman rdf:about="cn:Steven">
    <rdfs:label>Steven Universe</rdfs:label>
    <cn:arkadaşı rdf:resource="cn:Garnet"/>
  </cn:Kahraman>

  <cn:Kahraman rdf:about="cn:Garnet">
    <rdfs:label>Garnet</rdfs:label>
  </cn:Kahraman>

  <cn:Kahraman rdf:about="cn:Jack">
    <rdfs:label>Samurai Jack</rdfs:label>
    <cn:düşmanı rdf:resource="cn:Aku"/>
  </cn:Kahraman>

  <cn:KötüAdam rdf:about="cn:Aku">
    <rdfs:label>Aku</rdfs:label>
    <cn:düşmanı rdf:resource="cn:Jack"/>
  </cn:KötüAdam>

  <cn:Kahraman rdf:about="cn:Blossom">
    <rdfs:label>Blossom</rdfs:label>
    <cn:arkadaşı rdf:resource="cn:Bubbles"/>
    <cn:arkadaşı rdf:resource="cn:Buttercup"/>
    <cn:düşmanı rdf:resource="cn:MojoJojo"/>
  </cn:Kahraman>

  <cn:Kahraman rdf:about="cn:Bubbles">
    <rdfs:label>Bubbles</rdfs:label>
  </cn:Kahraman>

  <cn:Kahraman rdf:about="cn:Buttercup">
    <rdfs:label>Buttercup</rdfs:label>
  </cn:Kahraman>

  <cn:KötüAdam rdf:about="cn:MojoJojo">
    <rdfs:label>Mojo Jojo</rdfs:label>
  </cn:KötüAdam>

  <cn:Kahraman rdf:about="cn:Dexter">
    <rdfs:label>Dexter</rdfs:label>
    <cn:düşmanı rdf:resource="cn:Dee_Dee"/>
  </cn:Kahraman>

  <cn:YanKarakter rdf:about="cn:Dee_Dee">
    <rdfs:label>Dee Dee</rdfs:label>
  </cn:YanKarakter>

  <cn:Kahraman rdf:about="cn:BenTennyson">
    <rdfs:label>Ben Tennyson</rdfs:label>
  </cn:Kahraman>

  <cn:Kahraman rdf:about="cn:Mordecai">
    <rdfs:label>Mordecai</rdfs:label>
    <cn:arkadaşı rdf:resource="cn:Rigby"/>
  </cn:Kahraman>

  <cn:Kahraman rdf:about="cn:Rigby">
    <rdfs:label>Rigby</rdfs:label>
    <cn:arkadaşı rdf:resource="cn:Mordecai"/>
  </cn:Kahraman>

</rdf:RDF>
