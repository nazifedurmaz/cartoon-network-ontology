cn:Pearl
    a cn:Kahraman ;
    rdfs:label "Pearl" ;
    cn:isim    "Pearl" ;
    cn:karakterdeÇıktığıFilm cn:StevenUniverse .

# --- Samurai Jack ---
cn:Jack
    a cn:Kahraman ;
    rdfs:label "Samurai Jack" ;
    cn:isim    "Samurai Jack" ;
    cn:karakterdeÇıktığıFilm cn:SamuraiJack ;
    cn:düşmanı  cn:Aku .

cn:Aku
    a cn:KötüAdam ;
    rdfs:label "Aku" ;
