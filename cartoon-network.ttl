@prefix cn:   <http://www.semanticweb.org/ontologies/2024/cartoonnetwork#> .
@prefix owl:  <http://www.w3.org/2002/07/owl#> .
@prefix rdf:  <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd:  <http://www.w3.org/2001/XMLSchema#> .
@prefix dc:   <http://purl.org/dc/elements/1.1/> .

# =============================================================
#  Ontoloji Meta Verisi
# =============================================================

<http://www.semanticweb.org/ontologies/2024/cartoonnetwork>
    a owl:Ontology ;
    dc:title "Cartoon Network Ontolojisi - Turtle Sürümü" ;
    dc:description "Cartoon Network çizgi filmlerini modelleyen Turtle formatında ontoloji." ;
    owl:versionInfo "1.0.0" .

# =============================================================
#  SINIFLAR (Classes)
# =============================================================

cn:ÇizgiFilm
    a owl:Class ;
    rdfs:label "Çizgi Film"@tr, "Cartoon"@en ;
    rdfs:comment "Cartoon Network'te yayınlanan animasyon yapımlarının üst sınıfı."@tr .

cn:AksiyonÇizgiFilmi
    a owl:Class ;
    rdfs:subClassOf cn:ÇizgiFilm ;
    rdfs:label "Aksiyon Çizgi Filmi"@tr, "Action Cartoon"@en .

cn:KomediÇizgiFilmi
    a owl:Class ;
    rdfs:subClassOf cn:ÇizgiFilm ;
    rdfs:label "Komedi Çizgi Filmi"@tr, "Comedy Cartoon"@en .

cn:BilimKurguÇizgiFilmi
    a owl:Class ;
    rdfs:subClassOf cn:ÇizgiFilm ;
    rdfs:label "Bilim Kurgu Çizgi Filmi"@tr, "Sci-Fi Cartoon"@en .

cn:FanteziÇizgiFilmi
    a owl:Class ;
    rdfs:subClassOf cn:ÇizgiFilm ;
    rdfs:label "Fantezi Çizgi Filmi"@tr, "Fantasy Cartoon"@en .

cn:Karakter
    a owl:Class ;
    rdfs:label "Karakter"@tr, "Character"@en ;
    rdfs:comment "Bir çizgi filmde yer alan kurgusal karakter."@tr .

cn:Kahraman
    a owl:Class ;
    rdfs:subClassOf cn:Karakter ;
    rdfs:label "Kahraman"@tr, "Hero"@en .

cn:KötüAdam
    a owl:Class ;
    rdfs:subClassOf cn:Karakter ;
    rdfs:label "Kötü Adam"@tr, "Villain"@en .

cn:YanKarakter
    a owl:Class ;
    rdfs:subClassOf cn:Karakter ;
    rdfs:label "Yan Karakter"@tr, "Supporting Character"@en .

cn:YapımcıŞirket
    a owl:Class ;
    rdfs:label "Yapımcı Şirket"@tr, "Production Company"@en .

cn:Yaratıcı
    a owl:Class ;
    rdfs:label "Yaratıcı"@tr, "Creator"@en .

cn:Sezon
    a owl:Class ;
    rdfs:label "Sezon"@tr, "Season"@en .

cn:Bölüm
    a owl:Class ;
    rdfs:label "Bölüm"@tr, "Episode"@en .

# =============================================================
#  NESNE ÖZELLİKLERİ (Object Properties)
# =============================================================

cn:karakteriVar
    a owl:ObjectProperty ;
    rdfs:domain cn:ÇizgiFilm ;
    rdfs:range  cn:Karakter ;
    rdfs:label  "karakteri var"@tr, "has character"@en .

cn:karakterdeÇıktığıFilm
    a owl:ObjectProperty ;
    owl:inverseOf cn:karakteriVar ;
    rdfs:domain cn:Karakter ;
    rdfs:range  cn:ÇizgiFilm ;
    rdfs:label  "karakterde çıktığı film"@tr, "appears in"@en .

cn:tarafındanYaratıldı
    a owl:ObjectProperty ;
    rdfs:domain cn:ÇizgiFilm ;
    rdfs:range  cn:Yaratıcı ;
    rdfs:label  "tarafından yaratıldı"@tr, "created by"@en .

cn:tarafındanYapıldı
    a owl:ObjectProperty ;
    rdfs:domain cn:ÇizgiFilm ;
    rdfs:range  cn:YapımcıŞirket ;
    rdfs:label  "tarafından yapıldı"@tr, "produced by"@en .

cn:arkadaşı
    a owl:ObjectProperty, owl:SymmetricProperty ;
    rdfs:domain cn:Karakter ;
    rdfs:range  cn:Karakter ;
    rdfs:label  "arkadaşı"@tr, "friend of"@en .

cn:düşmanı
    a owl:ObjectProperty, owl:SymmetricProperty ;
    rdfs:domain cn:Karakter ;
    rdfs:range  cn:Karakter ;
    rdfs:label  "düşmanı"@tr, "enemy of"@en .

cn:sezoniçerir
    a owl:ObjectProperty ;
    rdfs:domain cn:ÇizgiFilm ;
    rdfs:range  cn:Sezon ;
    rdfs:label  "sezon içerir"@tr, "has season"@en .

cn:bölümiçerir
    a owl:ObjectProperty ;
    rdfs:domain cn:Sezon ;
    rdfs:range  cn:Bölüm ;
    rdfs:label  "bölüm içerir"@tr, "has episode"@en .

# =============================================================
#  VERİ ÖZELLİKLERİ (Data Properties)
# =============================================================

cn:yayınYılı
    a owl:DatatypeProperty ;
    rdfs:domain cn:ÇizgiFilm ;
    rdfs:range  xsd:integer ;
    rdfs:label  "yayın yılı"@tr, "air year"@en .

cn:bitişYılı
    a owl:DatatypeProperty ;
    rdfs:domain cn:ÇizgiFilm ;
    rdfs:range  xsd:integer ;
    rdfs:label  "bitiş yılı"@tr, "end year"@en .

cn:sezonSayısı
    a owl:DatatypeProperty ;
    rdfs:domain cn:ÇizgiFilm ;
    rdfs:range  xsd:integer ;
    rdfs:label  "sezon sayısı"@tr, "number of seasons"@en .

cn:bölümSayısı
    a owl:DatatypeProperty ;
    rdfs:domain cn:ÇizgiFilm ;
    rdfs:range  xsd:integer ;
    rdfs:label  "bölüm sayısı"@tr, "number of episodes"@en .

cn:isim
    a owl:DatatypeProperty ;
    rdfs:domain cn:Karakter ;
    rdfs:range  xsd:string ;
    rdfs:label  "isim"@tr, "name"@en .

cn:ülke
    a owl:DatatypeProperty ;
    rdfs:domain cn:YapımcıŞirket ;
    rdfs:range  xsd:string ;
    rdfs:label  "ülke"@tr, "country"@en .

# =============================================================
#  YAPIMCI ŞİRKETLER
# =============================================================

cn:CartoonNetworkStudios
    a cn:YapımcıŞirket ;
    rdfs:label "Cartoon Network Studios" ;
    cn:ülke    "ABD" .

cn:GennedyProductions
    a cn:YapımcıŞirket ;
    rdfs:label "Gennedy Productions" ;
    cn:ülke    "ABD" .

# =============================================================
#  YARATICLAR
# =============================================================

cn:PendletonWard
    a cn:Yaratıcı ;
    rdfs:label "Pendleton Ward" .

cn:RebeccaSugar
    a cn:Yaratıcı ;
    rdfs:label "Rebecca Sugar" .

cn:GennedyTartakovsky
    a cn:Yaratıcı ;
    rdfs:label "Gennedy Tartakovsky" .

cn:CraigMcCracken
    a cn:Yaratıcı ;
    rdfs:label "Craig McCracken" .

cn:JGQuintel
    a cn:Yaratıcı ;
    rdfs:label "J.G. Quintel" .

cn:ManSeungKim
    a cn:Yaratıcı ;
    rdfs:label "Man of Action (Steve Seagle, Joe Kelly, Joe Casey, Duncan Rouleau)" .

# =============================================================
#  ÇİZGİ FİLMLER
# =============================================================

cn:AdventureTime
    a cn:FanteziÇizgiFilmi ;
    rdfs:label      "Adventure Time"@en, "Macera Zamanı"@tr ;
    cn:yayınYılı    2010 ;
    cn:bitişYılı    2018 ;
    cn:sezonSayısı  10 ;
    cn:bölümSayısı  283 ;
    cn:tarafındanYaratıldı cn:PendletonWard ;
    cn:tarafındanYapıldı   cn:CartoonNetworkStudios ;
    cn:karakteriVar cn:Finn, cn:Jake, cn:IceKing, cn:PrincessBubblegum .

cn:StevenUniverse
    a cn:AksiyonÇizgiFilmi ;
    rdfs:label      "Steven Universe"@en, "Steven Evren"@tr ;
    cn:yayınYılı    2013 ;
    cn:bitişYılı    2019 ;
    cn:sezonSayısı  5 ;
    cn:bölümSayısı  160 ;
    cn:tarafındanYaratıldı cn:RebeccaSugar ;
    cn:tarafındanYapıldı   cn:CartoonNetworkStudios ;
    cn:karakteriVar cn:Steven, cn:Garnet, cn:Amethyst, cn:Pearl .

cn:SamuraiJack
    a cn:AksiyonÇizgiFilmi ;
    rdfs:label      "Samurai Jack"@en, "Samuray Jack"@tr ;
    cn:yayınYılı    2001 ;
    cn:bitişYılı    2017 ;
    cn:sezonSayısı  5 ;
    cn:bölümSayısı  62 ;
    cn:tarafındanYaratıldı cn:GennedyTartakovsky ;
    cn:tarafındanYapıldı   cn:CartoonNetworkStudios ;
    cn:karakteriVar cn:Jack, cn:Aku .

cn:ThePowerpuffGirls
    a cn:AksiyonÇizgiFilmi ;
    rdfs:label      "The Powerpuff Girls"@en, "Güçlü Kızlar"@tr ;
    cn:yayınYılı    1998 ;
    cn:bitişYılı    2005 ;
    cn:sezonSayısı  6 ;
    cn:bölümSayısı  78 ;
    cn:tarafındanYaratıldı cn:CraigMcCracken ;
    cn:tarafındanYapıldı   cn:CartoonNetworkStudios ;
    cn:karakteriVar cn:Blossom, cn:Bubbles, cn:Buttercup, cn:MojoJojo .

cn:DextersLaboratory
    a cn:KomediÇizgiFilmi ;
    rdfs:label      "Dexter's Laboratory"@en, "Dexter'ın Laboratuvarı"@tr ;
    cn:yayınYılı    1996 ;
    cn:bitişYılı    2003 ;
    cn:sezonSayısı  4 ;
    cn:bölümSayısı  78 ;
    cn:tarafındanYaratıldı cn:GennedyTartakovsky ;
    cn:tarafındanYapıldı   cn:CartoonNetworkStudios ;
    cn:karakteriVar cn:Dexter, cn:Dee_Dee .

cn:Ben10
    a cn:BilimKurguÇizgiFilmi ;
    rdfs:label      "Ben 10"@en ;
    cn:yayınYılı    2005 ;
    cn:bitişYılı    2008 ;
    cn:sezonSayısı  4 ;
    cn:bölümSayısı  52 ;
    cn:tarafındanYaratıldı cn:ManSeungKim ;
    cn:tarafındanYapıldı   cn:CartoonNetworkStudios ;
    cn:karakteriVar cn:BenTennyson, cn:Gwen, cn:GrandpaMax .

cn:RegularShow
    a cn:KomediÇizgiFilmi ;
    rdfs:label      "Regular Show"@en, "Sıradan Gösteri"@tr ;
    cn:yayınYılı    2010 ;
    cn:bitişYılı    2017 ;
    cn:sezonSayısı  8 ;
    cn:bölümSayısı  261 ;
    cn:tarafındanYaratıldı cn:JGQuintel ;
    cn:tarafındanYapıldı   cn:CartoonNetworkStudios ;
    cn:karakteriVar cn:Mordecai, cn:Rigby, cn:Benson, cn:Pops .

cn:CourageTheCowardlyDog
    a cn:KomediÇizgiFilmi ;
    rdfs:label      "Courage the Cowardly Dog"@en, "Korkak Köpek Courage"@tr ;
    cn:yayınYılı    1999 ;
    cn:bitişYılı    2002 ;
    cn:sezonSayısı  4 ;
    cn:bölümSayısı  52 ;
    cn:tarafındanYapıldı cn:CartoonNetworkStudios ;
    cn:karakteriVar cn:Courage, cn:Muriel, cn:Eustace .

# =============================================================
#  KARAKTERLER
# =============================================================

# --- Adventure Time ---
cn:Finn
    a cn:Kahraman ;
    rdfs:label "Finn the Human" ;
    cn:isim    "Finn the Human" ;
    cn:karakterdeÇıktığıFilm cn:AdventureTime ;
    cn:arkadaşı cn:Jake, cn:PrincessBubblegum ;
    cn:düşmanı  cn:IceKing .

cn:Jake
    a cn:Kahraman ;
    rdfs:label "Jake the Dog" ;
    cn:isim    "Jake the Dog" ;
    cn:karakterdeÇıktığıFilm cn:AdventureTime ;
    cn:arkadaşı cn:Finn .

cn:IceKing
    a cn:KötüAdam ;
    rdfs:label "Ice King" ;
    cn:isim    "Ice King" ;
    cn:karakterdeÇıktığıFilm cn:AdventureTime ;
    cn:düşmanı  cn:Finn .

cn:PrincessBubblegum
    a cn:YanKarakter ;
    rdfs:label "Princess Bubblegum" ;
    cn:isim    "Princess Bubblegum" ;
    cn:karakterdeÇıktığıFilm cn:AdventureTime .

