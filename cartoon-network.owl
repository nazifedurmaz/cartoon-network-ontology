<?xml version="1.0"?>
<rdf:RDF xmlns="http://www.semanticweb.org/ontologies/2024/cartoonnetwork#"
     xml:base="http://www.semanticweb.org/ontologies/2024/cartoonnetwork"
     xmlns:owl="http://www.w3.org/2002/07/owl#"
     xmlns:rdf="http://www.w3.org/1999/02/22-rdf-syntax-ns#"
     xmlns:xml="http://www.w3.org/XML/1998/namespace"
     xmlns:xsd="http://www.w3.org/2001/XMLSchema#"
     xmlns:rdfs="http://www.w3.org/2000/01/rdf-schema#"
     xmlns:dc="http://purl.org/dc/elements/1.1/"
     xmlns:cn="http://www.semanticweb.org/ontologies/2024/cartoonnetwork#">

    <owl:Ontology rdf:about="http://www.semanticweb.org/ontologies/2024/cartoonnetwork">
        <dc:title>Cartoon Network Ontolojisi</dc:title>
        <dc:description>Cartoon Network kanalında yayınlanan çizgi filmleri, karakterleri, türleri ve yapımcı şirketleri modelleyen bir OWL ontolojisi.</dc:description>
        <dc:creator>Cartoon Network Ontology Project</dc:creator>
        <dc:date>2024</dc:date>
        <owl:versionInfo>1.0.0</owl:versionInfo>
    </owl:Ontology>

    <!-- =========================================================== -->
    <!--  SINIFLAR (Classes)                                          -->
    <!-- =========================================================== -->

    <!-- ÇizgiFilm (üst sınıf) -->
    <owl:Class rdf:about="cn:ÇizgiFilm">
        <rdfs:label xml:lang="tr">Çizgi Film</rdfs:label>
        <rdfs:label xml:lang="en">Cartoon</rdfs:label>
        <rdfs:comment xml:lang="tr">Cartoon Network'te yayınlanan tüm çizgi dizi ve filmleri temsil eden üst sınıf.</rdfs:comment>
    </owl:Class>

    <!-- Aksiyon Çizgi Filmi -->
    <owl:Class rdf:about="cn:AksiyonÇizgiFilmi">
        <rdfs:subClassOf rdf:resource="cn:ÇizgiFilm"/>
        <rdfs:label xml:lang="tr">Aksiyon Çizgi Filmi</rdfs:label>
        <rdfs:label xml:lang="en">Action Cartoon</rdfs:label>
        <rdfs:comment xml:lang="tr">Aksiyon ve macera öğeleri ağır basan çizgi filmler.</rdfs:comment>
    </owl:Class>

    <!-- Komedi Çizgi Filmi -->
    <owl:Class rdf:about="cn:KomediÇizgiFilmi">
        <rdfs:subClassOf rdf:resource="cn:ÇizgiFilm"/>
        <rdfs:label xml:lang="tr">Komedi Çizgi Filmi</rdfs:label>
        <rdfs:label xml:lang="en">Comedy Cartoon</rdfs:label>
        <rdfs:comment xml:lang="tr">Mizah ve komedi öğeleri öne çıkan çizgi filmler.</rdfs:comment>
    </owl:Class>

    <!-- Bilim Kurgu Çizgi Filmi -->
    <owl:Class rdf:about="cn:BilimKurguÇizgiFilmi">
        <rdfs:subClassOf rdf:resource="cn:ÇizgiFilm"/>
        <rdfs:label xml:lang="tr">Bilim Kurgu Çizgi Filmi</rdfs:label>
        <rdfs:label xml:lang="en">Sci-Fi Cartoon</rdfs:label>
        <rdfs:comment xml:lang="tr">Bilim kurgu temalı çizgi filmler.</rdfs:comment>
    </owl:Class>

    <!-- Fantezi Çizgi Filmi -->
    <owl:Class rdf:about="cn:FanteziÇizgiFilmi">
        <rdfs:subClassOf rdf:resource="cn:ÇizgiFilm"/>
        <rdfs:label xml:lang="tr">Fantezi Çizgi Filmi</rdfs:label>
        <rdfs:label xml:lang="en">Fantasy Cartoon</rdfs:label>
        <rdfs:comment xml:lang="tr">Fantastik dünyalar ve büyü içeren çizgi filmler.</rdfs:comment>
    </owl:Class>

    <!-- Karakter -->
    <owl:Class rdf:about="cn:Karakter">
        <rdfs:label xml:lang="tr">Karakter</rdfs:label>
        <rdfs:label xml:lang="en">Character</rdfs:label>
        <rdfs:comment xml:lang="tr">Bir çizgi filmde yer alan kurgusal karakteri temsil eder.</rdfs:comment>
    </owl:Class>

    <!-- Kahraman -->
    <owl:Class rdf:about="cn:Kahraman">
        <rdfs:subClassOf rdf:resource="cn:Karakter"/>
        <rdfs:label xml:lang="tr">Kahraman</rdfs:label>
        <rdfs:label xml:lang="en">Hero</rdfs:label>
        <rdfs:comment xml:lang="tr">İyi tarafta yer alan ana karakter.</rdfs:comment>
    </owl:Class>

    <!-- Kötü Adam -->
    <owl:Class rdf:about="cn:KötüAdam">
        <rdfs:subClassOf rdf:resource="cn:Karakter"/>
        <rdfs:label xml:lang="tr">Kötü Adam</rdfs:label>
        <rdfs:label xml:lang="en">Villain</rdfs:label>
        <rdfs:comment xml:lang="tr">Antagonist rol üstlenen karakter.</rdfs:comment>
    </owl:Class>

    <!-- Yan Karakter -->
    <owl:Class rdf:about="cn:YanKarakter">
        <rdfs:subClassOf rdf:resource="cn:Karakter"/>
        <rdfs:label xml:lang="tr">Yan Karakter</rdfs:label>
        <rdfs:label xml:lang="en">Supporting Character</rdfs:label>
        <rdfs:comment xml:lang="tr">Ana hikayeye destek veren ikincil karakter.</rdfs:comment>
    </owl:Class>

    <!-- Yapımcı Şirket -->
    <owl:Class rdf:about="cn:YapımcıŞirket">
        <rdfs:label xml:lang="tr">Yapımcı Şirket</rdfs:label>
        <rdfs:label xml:lang="en">Production Company</rdfs:label>
        <rdfs:comment xml:lang="tr">Çizgi filmi üreten stüdyo veya şirket.</rdfs:comment>
    </owl:Class>

    <!-- Yaratıcı -->
    <owl:Class rdf:about="cn:Yaratıcı">
        <rdfs:label xml:lang="tr">Yaratıcı</rdfs:label>
        <rdfs:label xml:lang="en">Creator</rdfs:label>
        <rdfs:comment xml:lang="tr">Çizgi filmi yaratan kişi veya ekip.</rdfs:comment>
    </owl:Class>

    <!-- Bölüm -->
    <owl:Class rdf:about="cn:Bölüm">
        <rdfs:label xml:lang="tr">Bölüm</rdfs:label>
        <rdfs:label xml:lang="en">Episode</rdfs:label>
        <rdfs:comment xml:lang="tr">Bir çizgi film serisinin tek bir bölümü.</rdfs:comment>
    </owl:Class>

    <!-- Sezon -->
    <owl:Class rdf:about="cn:Sezon">
        <rdfs:label xml:lang="tr">Sezon</rdfs:label>
        <rdfs:label xml:lang="en">Season</rdfs:label>
        <rdfs:comment xml:lang="tr">Bir çizgi film serisinin yayın sezonu.</rdfs:comment>
    </owl:Class>

    <!-- =========================================================== -->
    <!--  NESNE ÖZELLİKLERİ (Object Properties)                      -->
    <!-- =========================================================== -->

    <owl:ObjectProperty rdf:about="cn:karakteriVar">
        <rdfs:domain rdf:resource="cn:ÇizgiFilm"/>
        <rdfs:range rdf:resource="cn:Karakter"/>
        <rdfs:label xml:lang="tr">karakteri var</rdfs:label>
        <rdfs:label xml:lang="en">has character</rdfs:label>
    </owl:ObjectProperty>

    <owl:ObjectProperty rdf:about="cn:karakterdeÇıktığıFilm">
        <owl:inverseOf rdf:resource="cn:karakteriVar"/>
        <rdfs:domain rdf:resource="cn:Karakter"/>
        <rdfs:range rdf:resource="cn:ÇizgiFilm"/>
        <rdfs:label xml:lang="tr">karakterde çıktığı film</rdfs:label>
        <rdfs:label xml:lang="en">appears in</rdfs:label>
    </owl:ObjectProperty>

    <owl:ObjectProperty rdf:about="cn:tarafındanYapıldı">
        <rdfs:domain rdf:resource="cn:ÇizgiFilm"/>
        <rdfs:range rdf:resource="cn:YapımcıŞirket"/>
        <rdfs:label xml:lang="tr">tarafından yapıldı</rdfs:label>
        <rdfs:label xml:lang="en">produced by</rdfs:label>
    </owl:ObjectProperty>

    <owl:ObjectProperty rdf:about="cn:tarafındanYaratıldı">
        <rdfs:domain rdf:resource="cn:ÇizgiFilm"/>
        <rdfs:range rdf:resource="cn:Yaratıcı"/>
        <rdfs:label xml:lang="tr">tarafından yaratıldı</rdfs:label>
        <rdfs:label xml:lang="en">created by</rdfs:label>
    </owl:ObjectProperty>

    <owl:ObjectProperty rdf:about="cn:sezoniçerir">
        <rdfs:domain rdf:resource="cn:ÇizgiFilm"/>
        <rdfs:range rdf:resource="cn:Sezon"/>
        <rdfs:label xml:lang="tr">sezon içerir</rdfs:label>
        <rdfs:label xml:lang="en">has season</rdfs:label>
    </owl:ObjectProperty>

    <owl:ObjectProperty rdf:about="cn:bölümiçerir">
        <rdfs:domain rdf:resource="cn:Sezon"/>
        <rdfs:range rdf:resource="cn:Bölüm"/>
        <rdfs:label xml:lang="tr">bölüm içerir</rdfs:label>
        <rdfs:label xml:lang="en">has episode</rdfs:label>
    </owl:ObjectProperty>

    <owl:ObjectProperty rdf:about="cn:arkadaşı">
        <rdfs:domain rdf:resource="cn:Karakter"/>
        <rdfs:range rdf:resource="cn:Karakter"/>
        <rdf:type rdf:resource="owl:SymmetricProperty"/>
        <rdfs:label xml:lang="tr">arkadaşı</rdfs:label>
        <rdfs:label xml:lang="en">friend of</rdfs:label>
    </owl:ObjectProperty>

    <owl:ObjectProperty rdf:about="cn:düşmanı">
        <rdfs:domain rdf:resource="cn:Karakter"/>
        <rdfs:range rdf:resource="cn:Karakter"/>
        <rdf:type rdf:resource="owl:SymmetricProperty"/>
        <rdfs:label xml:lang="tr">düşmanı</rdfs:label>
        <rdfs:label xml:lang="en">enemy of</rdfs:label>
    </owl:ObjectProperty>

    <!-- =========================================================== -->
    <!--  VERİ ÖZELLİKLERİ (Data Properties)                         -->
    <!-- =========================================================== -->

    <owl:DatatypeProperty rdf:about="cn:yayınYılı">
        <rdfs:domain rdf:resource="cn:ÇizgiFilm"/>
        <rdfs:range rdf:resource="xsd:integer"/>
        <rdfs:label xml:lang="tr">yayın yılı</rdfs:label>
        <rdfs:label xml:lang="en">air year</rdfs:label>
    </owl:DatatypeProperty>

    <owl:DatatypeProperty rdf:about="cn:bitişYılı">
        <rdfs:domain rdf:resource="cn:ÇizgiFilm"/>
        <rdfs:range rdf:resource="xsd:integer"/>
        <rdfs:label xml:lang="tr">bitiş yılı</rdfs:label>
        <rdfs:label xml:lang="en">end year</rdfs:label>
    </owl:DatatypeProperty>

    <owl:DatatypeProperty rdf:about="cn:sezonSayısı">
        <rdfs:domain rdf:resource="cn:ÇizgiFilm"/>
        <rdfs:range rdf:resource="xsd:integer"/>
        <rdfs:label xml:lang="tr">sezon sayısı</rdfs:label>
        <rdfs:label xml:lang="en">number of seasons</rdfs:label>
    </owl:DatatypeProperty>

    <owl:DatatypeProperty rdf:about="cn:bölümSayısı">
        <rdfs:domain rdf:resource="cn:ÇizgiFilm"/>
        <rdfs:range rdf:resource="xsd:integer"/>
        <rdfs:label xml:lang="tr">bölüm sayısı</rdfs:label>
        <rdfs:label xml:lang="en">number of episodes</rdfs:label>
    </owl:DatatypeProperty>

    <owl:DatatypeProperty rdf:about="cn:isim">
        <rdfs:domain rdf:resource="cn:Karakter"/>
        <rdfs:range rdf:resource="xsd:string"/>
        <rdfs:label xml:lang="tr">isim</rdfs:label>
        <rdfs:label xml:lang="en">name</rdfs:label>
    </owl:DatatypeProperty>

    <owl:DatatypeProperty rdf:about="cn:ülke">
        <rdfs:domain rdf:resource="cn:YapımcıŞirket"/>
        <rdfs:range rdf:resource="xsd:string"/>
        <rdfs:label xml:lang="tr">ülke</rdfs:label>
        <rdfs:label xml:lang="en">country</rdfs:label>
    </owl:DatatypeProperty>

    <!-- =========================================================== -->
    <!--  BİREYLER (Individuals)                                      -->
    <!-- =========================================================== -->

    <!-- == Yapımcı Şirketler == -->
    <owl:NamedIndividual rdf:about="cn:CartoonNetworkStudios">
        <rdf:type rdf:resource="cn:YapımcıŞirket"/>
        <rdfs:label>Cartoon Network Studios</rdfs:label>
        <cn:ülke>ABD</cn:ülke>
    </owl:NamedIndividual>

    <owl:NamedIndividual rdf:about="cn:GennedyProductions">
        <rdf:type rdf:resource="cn:YapımcıŞirket"/>
        <rdfs:label>Gennedy Productions</rdfs:label>
        <cn:ülke>ABD</cn:ülke>
    </owl:NamedIndividual>

    <!-- == Yaratıcılar == -->
    <owl:NamedIndividual rdf:about="cn:PendletonWard">
        <rdf:type rdf:resource="cn:Yaratıcı"/>
        <rdfs:label>Pendleton Ward</rdfs:label>
    </owl:NamedIndividual>

    <owl:NamedIndividual rdf:about="cn:RebeccaSugar">
        <rdf:type rdf:resource="cn:Yaratıcı"/>
        <rdfs:label>Rebecca Sugar</rdfs:label>
    </owl:NamedIndividual>

    <owl:NamedIndividual rdf:about="cn:GennedyTartakovsky">
        <rdf:type rdf:resource="cn:Yaratıcı"/>
        <rdfs:label>Gennedy Tartakovsky</rdfs:label>
    </owl:NamedIndividual>

    <owl:NamedIndividual rdf:about="cn:CraigMcCracken">
        <rdf:type rdf:resource="cn:Yaratıcı"/>
        <rdfs:label>Craig McCracken</rdfs:label>
    </owl:NamedIndividual>

    <!-- == ÇİZGİ FİLMLER == -->

    <!-- Adventure Time -->
    <owl:NamedIndividual rdf:about="cn:AdventureTime">
        <rdf:type rdf:resource="cn:FanteziÇizgiFilmi"/>
        <rdfs:label xml:lang="tr">Macera Zamanı</rdfs:label>
        <rdfs:label xml:lang="en">Adventure Time</rdfs:label>
        <cn:yayınYılı rdf:datatype="xsd:integer">2010</cn:yayınYılı>
        <cn:bitişYılı rdf:datatype="xsd:integer">2018</cn:bitişYılı>
        <cn:sezonSayısı rdf:datatype="xsd:integer">10</cn:sezonSayısı>
        <cn:bölümSayısı rdf:datatype="xsd:integer">283</cn:bölümSayısı>
        <cn:tarafındanYaratıldı rdf:resource="cn:PendletonWard"/>
        <cn:tarafındanYapıldı rdf:resource="cn:CartoonNetworkStudios"/>
    </owl:NamedIndividual>

    <!-- Steven Universe -->
    <owl:NamedIndividual rdf:about="cn:StevenUniverse">
        <rdf:type rdf:resource="cn:AksiyonÇizgiFilmi"/>
        <rdfs:label xml:lang="tr">Steven Evren</rdfs:label>
        <rdfs:label xml:lang="en">Steven Universe</rdfs:label>
        <cn:yayınYılı rdf:datatype="xsd:integer">2013</cn:yayınYılı>
        <cn:bitişYılı rdf:datatype="xsd:integer">2019</cn:bitişYılı>
        <cn:sezonSayısı rdf:datatype="xsd:integer">5</cn:sezonSayısı>
        <cn:bölümSayısı rdf:datatype="xsd:integer">160</cn:bölümSayısı>
        <cn:tarafındanYaratıldı rdf:resource="cn:RebeccaSugar"/>
        <cn:tarafındanYapıldı rdf:resource="cn:CartoonNetworkStudios"/>
    </owl:NamedIndividual>

    <!-- Samurai Jack -->
    <owl:NamedIndividual rdf:about="cn:SamuraiJack">
        <rdf:type rdf:resource="cn:AksiyonÇizgiFilmi"/>
        <rdfs:label xml:lang="tr">Samuray Jack</rdfs:label>
        <rdfs:label xml:lang="en">Samurai Jack</rdfs:label>
        <cn:yayınYılı rdf:datatype="xsd:integer">2001</cn:yayınYılı>
        <cn:bitişYılı rdf:datatype="xsd:integer">2017</cn:bitişYılı>
        <cn:sezonSayısı rdf:datatype="xsd:integer">5</cn:sezonSayısı>
        <cn:bölümSayısı rdf:datatype="xsd:integer">62</cn:bölümSayısı>
        <cn:tarafındanYaratıldı rdf:resource="cn:GennedyTartakovsky"/>
        <cn:tarafındanYapıldı rdf:resource="cn:CartoonNetworkStudios"/>
    </owl:NamedIndividual>

    <!-- The Powerpuff Girls -->
    <owl:NamedIndividual rdf:about="cn:ThePowerpuffGirls">
        <rdf:type rdf:resource="cn:AksiyonÇizgiFilmi"/>
        <rdfs:label xml:lang="tr">Güçlü Kızlar</rdfs:label>
        <rdfs:label xml:lang="en">The Powerpuff Girls</rdfs:label>
        <cn:yayınYılı rdf:datatype="xsd:integer">1998</cn:yayınYılı>
        <cn:bitişYılı rdf:datatype="xsd:integer">2005</cn:bitişYılı>
        <cn:sezonSayısı rdf:datatype="xsd:integer">6</cn:sezonSayısı>
        <cn:bölümSayısı rdf:datatype="xsd:integer">78</cn:bölümSayısı>
        <cn:tarafındanYaratıldı rdf:resource="cn:CraigMcCracken"/>
        <cn:tarafındanYapıldı rdf:resource="cn:CartoonNetworkStudios"/>
    </owl:NamedIndividual>

    <!-- Dexter's Laboratory -->
    <owl:NamedIndividual rdf:about="cn:DextersLaboratory">
        <rdf:type rdf:resource="cn:KomediÇizgiFilmi"/>
        <rdfs:label xml:lang="tr">Dexter'ın Laboratuvarı</rdfs:label>
        <rdfs:label xml:lang="en">Dexter's Laboratory</rdfs:label>
        <cn:yayınYılı rdf:datatype="xsd:integer">1996</cn:yayınYılı>
        <cn:bitişYılı rdf:datatype="xsd:integer">2003</cn:bitişYılı>
        <cn:sezonSayısı rdf:datatype="xsd:integer">4</cn:sezonSayısı>
        <cn:bölümSayısı rdf:datatype="xsd:integer">78</cn:bölümSayısı>
        <cn:tarafındanYaratıldı rdf:resource="cn:GennedyTartakovsky"/>
        <cn:tarafındanYapıldı rdf:resource="cn:CartoonNetworkStudios"/>
    </owl:NamedIndividual>

    <!-- Ben 10 -->
    <owl:NamedIndividual rdf:about="cn:Ben10">
        <rdf:type rdf:resource="cn:BilimKurguÇizgiFilmi"/>
        <rdfs:label xml:lang="tr">Ben 10</rdfs:label>
        <rdfs:label xml:lang="en">Ben 10</rdfs:label>
        <cn:yayınYılı rdf:datatype="xsd:integer">2005</cn:yayınYılı>
        <cn:bitişYılı rdf:datatype="xsd:integer">2008</cn:bitişYılı>
        <cn:sezonSayısı rdf:datatype="xsd:integer">4</cn:sezonSayısı>
        <cn:bölümSayısı rdf:datatype="xsd:integer">52</cn:bölümSayısı>
        <cn:tarafındanYapıldı rdf:resource="cn:CartoonNetworkStudios"/>
    </owl:NamedIndividual>

    <!-- Regular Show -->
    <owl:NamedIndividual rdf:about="cn:RegularShow">
        <rdf:type rdf:resource="cn:KomediÇizgiFilmi"/>
        <rdfs:label xml:lang="tr">Sıradan Gösteri</rdfs:label>
        <rdfs:label xml:lang="en">Regular Show</rdfs:label>
        <cn:yayınYılı rdf:datatype="xsd:integer">2010</cn:yayınYılı>
        <cn:bitişYılı rdf:datatype="xsd:integer">2017</cn:bitişYılı>
        <cn:sezonSayısı rdf:datatype="xsd:integer">8</cn:sezonSayısı>
        <cn:bölümSayısı rdf:datatype="xsd:integer">261</cn:bölümSayısı>
        <cn:tarafındanYapıldı rdf:resource="cn:CartoonNetworkStudios"/>
    </owl:NamedIndividual>

    <!-- == KARAKTERLER == -->

    <!-- Finn -->
    <owl:NamedIndividual rdf:about="cn:Finn">
        <rdf:type rdf:resource="cn:Kahraman"/>
        <cn:isim>Finn the Human</cn:isim>
        <rdfs:label>Finn</rdfs:label>
        <cn:karakterdeÇıktığıFilm rdf:resource="cn:AdventureTime"/>
        <cn:arkadaşı rdf:resource="cn:Jake"/>
    </owl:NamedIndividual>

    <!-- Jake -->
    <owl:NamedIndividual rdf:about="cn:Jake">
        <rdf:type rdf:resource="cn:Kahraman"/>
        <cn:isim>Jake the Dog</cn:isim>
        <rdfs:label>Jake</rdfs:label>
        <cn:karakterdeÇıktığıFilm rdf:resource="cn:AdventureTime"/>
        <cn:arkadaşı rdf:resource="cn:Finn"/>
    </owl:NamedIndividual>

    <!-- IceKing -->
    <owl:NamedIndividual rdf:about="cn:IceKing">
        <rdf:type rdf:resource="cn:KötüAdam"/>
        <cn:isim>Ice King</cn:isim>
        <rdfs:label>Ice King</rdfs:label>
        <cn:karakterdeÇıktığıFilm rdf:resource="cn:AdventureTime"/>
        <cn:düşmanı rdf:resource="cn:Finn"/>
    </owl:NamedIndividual>

    <!-- Steven -->
    <owl:NamedIndividual rdf:about="cn:Steven">
        <rdf:type rdf:resource="cn:Kahraman"/>
        <cn:isim>Steven Universe</cn:isim>
        <rdfs:label>Steven</rdfs:label>
        <cn:karakterdeÇıktığıFilm rdf:resource="cn:StevenUniverse"/>
    </owl:NamedIndividual>

    <!-- Garnet -->
    <owl:NamedIndividual rdf:about="cn:Garnet">
        <rdf:type rdf:resource="cn:Kahraman"/>
        <cn:isim>Garnet</cn:isim>
        <rdfs:label>Garnet</rdfs:label>
        <cn:karakterdeÇıktığıFilm rdf:resource="cn:StevenUniverse"/>
        <cn:arkadaşı rdf:resource="cn:Steven"/>
    </owl:NamedIndividual>

    <!-- Jack -->
    <owl:NamedIndividual rdf:about="cn:Jack">
        <rdf:type rdf:resource="cn:Kahraman"/>
        <cn:isim>Samurai Jack</cn:isim>
        <rdfs:label>Jack</rdfs:label>
        <cn:karakterdeÇıktığıFilm rdf:resource="cn:SamuraiJack"/>
        <cn:düşmanı rdf:resource="cn:Aku"/>
    </owl:NamedIndividual>

    <!-- Aku -->
    <owl:NamedIndividual rdf:about="cn:Aku">
        <rdf:type rdf:resource="cn:KötüAdam"/>
        <cn:isim>Aku</cn:isim>
        <rdfs:label>Aku</rdfs:label>
        <cn:karakterdeÇıktığıFilm rdf:resource="cn:SamuraiJack"/>
        <cn:düşmanı rdf:resource="cn:Jack"/>
    </owl:NamedIndividual>

    <!-- Blossom -->
    <owl:NamedIndividual rdf:about="cn:Blossom">
        <rdf:type rdf:resource="cn:Kahraman"/>
        <cn:isim>Blossom</cn:isim>
        <rdfs:label>Blossom</rdfs:label>
        <cn:karakterdeÇıktığıFilm rdf:resource="cn:ThePowerpuffGirls"/>
        <cn:arkadaşı rdf:resource="cn:Bubbles"/>
        <cn:arkadaşı rdf:resource="cn:Buttercup"/>
    </owl:NamedIndividual>

    <!-- Bubbles -->
    <owl:NamedIndividual rdf:about="cn:Bubbles">
        <rdf:type rdf:resource="cn:Kahraman"/>
        <cn:isim>Bubbles</cn:isim>
        <rdfs:label>Bubbles</rdfs:label>
        <cn:karakterdeÇıktığıFilm rdf:resource="cn:ThePowerpuffGirls"/>
    </owl:NamedIndividual>

    <!-- Buttercup -->
    <owl:NamedIndividual rdf:about="cn:Buttercup">
        <rdf:type rdf:resource="cn:Kahraman"/>
        <cn:isim>Buttercup</cn:isim>
        <rdfs:label>Buttercup</rdfs:label>
        <cn:karakterdeÇıktığıFilm rdf:resource="cn:ThePowerpuffGirls"/>
    </owl:NamedIndividual>

    <!-- Mojo Jojo -->
    <owl:NamedIndividual rdf:about="cn:MojoJojo">
        <rdf:type rdf:resource="cn:KötüAdam"/>
